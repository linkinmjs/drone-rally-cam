[internationalization]

locale/translations=PackedStringArray("res://localization/translations.es.translation", "res://localization/translations.en.translation")
locale/fallback="es"

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="drone_body"
3d_physics/layer_1="terrain"
3d_physics/layer_2="drone"
3d_physics/layer_3="car"
3d_physics/layer_4="player"
3d_physics/layer_5="interactable"

[physics]

common/physics_ticks_per_second=100
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81

[rendering]

renderer/rendering_method.mobile="forward_plus"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
