[gd_scene format=3]

[ext_resource type="Script" path="res://ui/results_screen.gd" id="1_script"]

[node name="ResultsScreen" type="MarginContainer"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 64

[node name="MenuColumn" type="VBoxContainer" parent="Layout"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="Layout/MenuColumn"]
